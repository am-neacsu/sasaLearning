# Supabase PostgreSQL connection string (use the Session Pooler URI for IPv4-only networks)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&schema=public"
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
